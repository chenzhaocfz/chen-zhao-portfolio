---
// src/pages/index.astro
import '../styles/global.css';

const mode = import.meta.env.PORTFOLIO_TYPE || 'creative';
const isAcademic = mode === 'academic';

const title = isAcademic 
  ? "Chen Zhao | CS Systems & AI Alignment Researcher"
  : "Chen Zhao | Creative Computing & Systems Developer";

const description = isAcademic
  ? "Computer Science portfolio of Chen Zhao — Specialized in AI Alignment, Reasoning Faithfulness, and Distributed Systems."
  : "Creative computing portfolio of Chen Zhao — Physical computing, human-robot interaction, retro game design, and systems engineering.";

const youtubeVideoId = "9hRGt3oDyFk";

const zigZagPath = "M0 7 L20 1 L40 13 L60 1 L80 13 L100 1 L120 13 L140 1 L160 13 L180 1 L200 13 L220 1 L240 13 L260 1 L280 13 L300 1 L320 13 L340 1 L360 13 L380 1 L400 13 L420 1 L440 13 L460 1 L480 13 L500 1 L520 13 L540 1 L560 13 L580 1 L600 13 L620 1 L640 13 L660 1 L680 13 L700 1 L720 13 L740 1 L760 13 L780 1 L800 13 L820 1 L840 13 L860 1 L880 13 L900 1 L920 13 L940 1 L960 13 L980 1 L1000 13 L1020 1 L1040 13 L1060 1 L1080 13 L1100 1 L1120 13 L1140 1 L1160 13 L1180 1 L1200 7";

const layoutYaml = `# ==============================================================================
# LAYER 1: MULTI-TEMPLATE LAYOUT ARCHITECTURE
# ==============================================================================
width: 640
height: 400
gap: 0

theme:
  colors:
    background: "#000000"
    border_primary: "#FFFF55"   # EGA Yellow
    border_secondary: "#FF55FF" # EGA Magenta
    text_primary: "#FFFFFF"     # EGA White
    text_accent: "#00AAAA"      # EGA Cyan
  directives:
    - "No rounded corners, gradients, CSS drop-shadows, or glowing neon monitors."
    - "All containers and elements must use rigid 90-degree box corners."
    - "All text must render using standard monospace/pixelated styling with standard anti-aliasing disabled."
    - "All borders must be thick, solid, and styled with multi-colored patterns."

templates:
  title_screen:
    direction: row
    regions:
      dragon_pane: { width: "25%" }
      menu_pane: { flex_grow: 1, direction: column, justify: center, align: center }
      tiger_pane: { width: "25%" }

  main_gameplay:
    direction: row
    regions:
      map_pane: { width: "55%" }
      sidebar:
        gap: 8
        padding: 8
        regions:
          header:
            height: 80
            direction: row
            regions:
              info_text: { flex_grow: 3 }
              portrait_box: { width: 80 }
          content:
            regions:
              stats_view: {}
              graphic_view: {}
          action: { height: 120 }

  battlefield:
    direction: row
    regions:
      tactical_grid: { width: "55%" }
      battle_sidebar:
        gap: 8
        padding: 8
        regions:
          battle_stats: { height: "50%" }
          battle_action: { flex_grow: 1 }`;

const elementsYaml = `# ==============================================================================
# LAYER 2: ELEMENT MANIFEST (Component Catalog & Slot Bindings)
# ==============================================================================
dragon_art:
  type: image
  slot: title_screen.dragon_pane
  selector: "img.dragon-sprite"

title_main_menu:
  type: menu
  slot: title_screen.menu_pane
  selector: "ul.main-menu-options"
  properties:
    localization: "Traditional Chinese"
    options: ["1. 啟動新遊戲", "2. 裝入數據", "3. 結束"]

china_map:
  type: canvas
  slot: main_gameplay.map_pane
  selector: "canvas#province-map"
  properties:
    visual_model: "Solid regional polygon landmass representing 41 provinces with thin black borders."
    palette: "White, Magenta, Cyan, and Yellow flat fills only."
    labeling: "Numeric ID in center using small pixel font."

province_stats_table:
  type: table
  slot: main_gameplay.sidebar.content.stats_view
  selector: "table.stats-grid"
  properties:
    localization: "Traditional Chinese"
    labels: ["人口", "士兵", "在職將領", "在野將領", "黃金", "糧食", "米價", "良駒", "民忠誠度", "地價", "治水度", "城堡"]

battle_hex_map:
  type: grid
  slot: battlefield.tactical_grid
  selector: "canvas#battlefield-map"
  properties:
    visual_model: "10x10 grid map of pixel tiles depicting trees, rivers, mountains, and castles."`;

const statesYaml = `# ==============================================================================
# LAYER 3: COMPREHENSIVE BEHAVIOR STATE ROUTING & DIFFS
# ==============================================================================
title_screen_state:
  template: "title_screen"
  active_elements: [dragon_art, tiger_art, title_main_menu]

base_gameplay:
  template: "main_gameplay"
  active_elements: [china_map, ruler_info_label, governor_portrait]

governor_personnel_screen:
  extends: base_gameplay
  active_elements:
    - active_province_highlight
    - province_stats_table
    - personnel_options_menu

battle_combat_phase:
  template: "battlefield"
  active_elements: [battle_hex_map, combatant_matchup_panel, battle_command_menu]

captured_disposal_screen:
  template: "main_gameplay"
  extends: base_gameplay
  active_elements:
    - -ruler_info_label
    - -governor_portrait
    - +captured_general_portrait
    - +captured_general_stats
    - +disposal_action_menu`;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": "https://chenzhao.dev/#person",
      "name": "Chen Zhao",
      "jobTitle": "AI Research Assistant & Software Systems Developer",
      "worksFor": {
        "@type": "Organization",
        "name": "Sheridan College Centre for Applied AI (CAAI) × StereoLOGIC",
        "department": "Ontario Centres of Innovation (OCI) Digital Twin Project"
      },
      "alumniOf": {
        "@type": "EducationalOrganization",
        "name": "Sheridan College",
        "program": "Honours Bachelor of Computer Science (Cloud Computing Specialization)"
      },
      "sameAs": [
        "https://github.com/chenzhaocfz",
        "https://linkedin.com/in/chen-zhao-cfz/"
      ],
      "knowsAbout": [
        "AI Alignment",
        "Reasoning Faithfulness",
        "LoRA & Parameter-Efficient Fine-Tuning",
        "Mechanistic Interpretability",
        "Physical Computing & Edge Robotics",
        "Financial Engineering & Quantitative Pricing"
      ]
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="profile" />
    
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="font-sans antialiased selection:bg-brand-500 selection:text-white">
    
    <!-- Navbar -->
    <header class="sticky top-0 z-40 glass-card border-b border-slate-800">
      <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
        <a href="#" class="font-mono text-lg font-bold text-white tracking-tight">
          Chen Zhao<span class="text-brand-500">.</span>
        </a>
        <nav class="hidden md:flex space-x-6 text-sm font-medium text-slate-400">
          <a href="#about" class="hover:text-white transition">About</a>
          <a href="#featured" class="hover:text-emerald-400 transition">{isAcademic ? "Thesis" : "Featured Project"}</a>
          <a href="#projects" class="hover:text-cyan-400 transition">Projects</a>
          <a href="#experience" class="hover:text-brand-400 transition">Experience &amp; Bio</a>
        </nav>
        <a 
          href="mailto:chen.zhao.cfz@gmail.com" 
          class="px-4 py-2 text-xs font-semibold rounded-lg bg-brand-600 hover:bg-brand-500 text-white transition shadow-lg shadow-brand-500/20"
        >
          Contact
        </a>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-6 py-12 space-y-20">
      
      <!-- Section 1: Hero Section -->
      <section id="about" class="pt-4">
        <div class="flex flex-col-reverse md:flex-row items-center justify-between gap-10">
          
          <div class="space-y-6 flex-1 text-center md:text-left">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono bg-brand-500/10 text-brand-400 border border-brand-500/20">
              <span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span>
              Sheridan College CS • Cloud Computing Specialization
            </div>
            
            <h1 class="text-4xl md:text-6xl font-extrabold text-white tracking-tight leading-tight">
              Software Developer &amp; <br />
              <span class="bg-gradient-to-r from-brand-500 via-indigo-400 to-cyan-400 bg-clip-text text-transparent">
                {isAcademic ? "AI Safety Researcher" : "Creative Systems Builder"}
              </span>
            </h1>
            
            <p class="text-base md:text-lg text-slate-400 max-w-xxl leading-relaxed mx-auto md:mx-0">
              {isAcademic ? (
                <>Hi, I'm Chen. I research reasoning faithfulness and mechanistic interpretability in Large Language Models. Beyond AI theory, I build autonomous physical computing systems and declarative specification compilers.</>
              ) : (
                <>Hi, I'm Chen. My work bridges reliable AI research and hands-on systems engineering, with past projects ranging from specification compilers to physical interactive computing installations. Right now, I'm pursuing my thesis on AI reasoning and faithfulness. Alongside my research, I develop AI pipelines for an industry collaboration with StereoLOGIC under the direction of Professor Nick Sajadi from Sheridan College, turning enterprise process, and task-mining data into actionable efficiency and cost savings.</>
              )}
            </p>

            <div class="flex flex-wrap gap-3 justify-center md:justify-start pt-1">
              <a 
                href="https://github.com/chenzhaocfz"
                target="_blank" 
                class="px-4 py-2 rounded-lg glass-card text-xs font-medium hover:text-white flex items-center gap-2 transition"
              >
                <svg class="w-3.5 h-3.5 text-slate-300" fill="currentColor" viewBox="0 0 24 24"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/></svg>
                GitHub
              </a>
              <a 
                href="https://linkedin.com/in/chen-zhao-cfz/" 
                target="_blank" 
                class="px-4 py-2 rounded-lg glass-card text-xs font-medium hover:text-white flex items-center gap-2 transition"
              >
                <svg class="w-3.5 h-3.5 text-brand-500" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
                LinkedIn
              </a>
              <a 
                href="mailto:chen.zhao.cfz@gmail.com" 
                class="px-4 py-2 rounded-lg glass-card text-xs font-medium hover:text-white flex items-center gap-2 transition"
              >
                <svg class="w-3.5 h-3.5 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 002-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                Email
              </a>
              <div class="px-4 py-2 rounded-lg glass-card text-xs font-mono text-slate-400 flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Toronto, ON
              </div>
            </div>
          </div>

          <div class="relative group">
            <div class="absolute -inset-1 bg-gradient-to-r from-brand-500 to-cyan-500 rounded-2xl blur opacity-30 group-hover:opacity-60 transition duration-500"></div>
            <div class="relative w-44 h-44 md:w-56 md:h-56 rounded-2xl overflow-hidden glass-card border-2 border-slate-700 bg-slate-900 flex items-center justify-center">
              <img 
                src="/avatar.jpg" 
                alt="Chen Zhao" 
                class="w-full h-full object-cover"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=500&auto=format&fit=crop&q=80';"
              />
            </div>
          </div>

        </div>
      </section>

      <!-- Section 2: FEATURED HERO CENTERPIECE -->
      <section id="featured" class="space-y-6">
        <div class="flex items-center gap-3">
          <h2 class="text-2xl font-bold text-white tracking-tight">
            {isAcademic ? "Flagship Thesis Research" : "Featured Project & Hardware Installation"}
          </h2>
          <div class="h-px bg-slate-800 flex-1"></div>
        </div>

        {isAcademic ? (
          <article id="card-featured-thesis" class="expandable-card glass-card rounded-2xl border-brand-500/30 relative overflow-hidden">
            
            <!-- COMPACT TEASER VIEW (SHRINKS & FADES OUT ON EXPAND) -->
            <div class="card-teaser">
              <div class="card-morph-inner">
                <div class="p-6 md:p-8 space-y-6">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class="px-3 py-1 rounded-md text-xs font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                      Bachelor's Thesis Proposal (2025–2026) • Sheridan CS
                    </span>
                    <span class="text-xs font-mono text-slate-400">Supervisors: Dr. Ghassem Tofighi, Prof. Richard Pyne</span>
                  </div>

                  <div class="space-y-2">
                    <h3 class="text-2xl md:text-3xl font-bold text-white">
                      Sequential Dual-LoRA vs. Monolithic Distillation
                    </h3>
                    <p class="text-sm font-mono text-brand-400">
                      Enforcing Causal Reasoning Faithfulness via Discrete Intermediate Representations
                    </p>
                  </div>

                  <p class="text-slate-300 text-sm leading-relaxed max-w-4xl">
                    In standard monolithic architectures, reasoning generation and answer readout share an entangled parameter space and continuous hidden activations, allowing models to bypass explicit logic and emit answers derived from latent parametric shortcuts (<strong class="text-red-400">readout unfaithfulness</strong>). This research proposes a <strong class="text-white">Sequential Dual-LoRA Architecture</strong> that physically decouples thinking from solving, establishing the reasoning trace as an inspectable, discrete Intermediate Representation (IR) that enforces a strict causal bottleneck.
                  </p>

                  <div class="flex flex-wrap gap-2 font-mono text-xs text-slate-400 pt-2">
                    <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800">DeepSeek-V3.2 Oracle</span>
                    <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800">Unsloth QLoRA</span>
                    <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800">vLLM Hot-Swap</span>
                    <span class="px-2.5 py-1 rounded bg-slate-900 border border-slate-800">McNemar's Test</span>
                  </div>
                </div>

                <!-- UNIFIED ZIG-ZAG BREAK EXPAND BAR -->
                <button type="button" data-expand-btn class="zig-break-btn group">
                  <svg class="zig-line-svg" preserveAspectRatio="none" viewBox="0 0 1200 14" fill="none">
                    <path d={zigZagPath} stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
                  </svg>
                  <div class="py-3.5 px-6 flex items-center gap-3 text-xs font-mono font-bold tracking-wider uppercase text-cyan-300 group-hover:text-white transition">
                    <span class="px-2 py-0.5 rounded bg-brand-500/20 border border-brand-400/30 text-brand-300">Full Thesis Paper</span>
                    <span>Unfold Architecture, Trap Test &amp; Faculty Reviews</span>
                    <svg class="w-4 h-4 text-cyan-400 zig-arrow-down" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 13l-7 7-7-7m14-8l-7 7-7-7"/></svg>
                  </div>
                </button>
              </div>
            </div>

            <!-- FULL STANDALONE PAGE VIEW (MORPHS IN ON EXPAND) -->
            <div class="card-fullpage">
              <div class="card-morph-inner">
                
                <!-- Top Fold Bar -->
                <div class="px-6 py-3 bg-slate-900/90 border-b border-slate-800 flex items-center justify-between">
                  <span class="text-xs font-mono text-brand-400">Sheridan College • Honours Bachelor of Computer Science Thesis</span>
                  <button type="button" data-expand-btn class="px-3 py-1 rounded-md bg-slate-800 hover:bg-slate-700 text-xs font-mono font-bold text-cyan-400 flex items-center gap-1.5 cursor-pointer transition">
                    <span>Fold Back to Card</span>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"/></svg>
                  </button>
                </div>

                <div class="p-6 md:p-10 space-y-12">
                  <!-- Full Thesis Hero Header -->
                  <div class="space-y-4">
                    <div class="flex flex-wrap items-center gap-2">
                      <span class="px-3 py-1 rounded-full text-xs font-mono bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
                        Bachelor's Thesis Proposal (2025–2026)
                      </span>
                      <span class="px-3 py-1 rounded-full text-xs font-mono bg-brand-500/10 text-brand-400 border border-brand-500/20">
                        AI Safety &amp; Alignment
                      </span>
                      <span class="px-3 py-1 rounded-full text-xs font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                        Mechanistic Interpretability
                      </span>
                    </div>
                    <h3 class="text-3xl md:text-5xl font-extrabold text-white tracking-tight leading-tight">
                      Sequential Dual-LoRA vs. Monolithic Distillation
                    </h3>
                    <p class="text-lg md:text-xl font-mono text-brand-400">
                      A Comparative Study of Reasoning Faithfulness in GSM8K
                    </p>
                    <p class="text-sm text-slate-400 font-mono pt-1">
                      Author: <strong class="text-slate-200">Chen Zhao</strong> • Supervisors: <strong class="text-slate-200">Dr. Ghassem Tofighi, Prof. Richard Pyne</strong>
                    </p>
                  </div>

                  <!-- 1. Motivation -->
                  <div class="space-y-4">
                    <h4 class="text-2xl font-bold text-white tracking-tight">1. Motivation: Readout Unfaithfulness in Reasoning Engines</h4>
                    <div class="glass-card p-6 md:p-8 rounded-2xl space-y-4 text-sm text-slate-300 leading-relaxed">
                      <p>
                        As Large Language Models have advanced from pattern matchers to multistep reasoning engines, empirical research has uncovered a critical reliability vulnerability: <strong class="text-white">reasoning unfaithfulness</strong>, and specifically <strong class="text-red-400">readout unfaithfulness</strong>, where the model bypasses its explicit reasoning trace to emit an answer derived from latent shortcuts and memorized parametric priors.
                      </p>
                      <p>
                        In standard monolithic architectures, reasoning generation and answer readout share an entangled parameter space and continuous hidden activations, eliminating any structural guarantee that the final prediction causally depends on the stated logic. This research addresses this interpretability gap by proposing a <strong class="text-white">Sequential Dual-LoRA Architecture</strong>.
                      </p>
                      <p>
                        By physically decoupling the "Thinking" and "Solving" phases within a single quantized Qwen-3-8B base model and clearing the Key-Value (KV) cache between steps, this framework establishes the intermediate reasoning trace as an inspectable, <strong class="text-cyan-400">discrete Intermediate Representation (IR)</strong>. This enforces a strict causal bottleneck, testing whether physical parameter separation compels the readout module to condition exclusively on explicit textual logic on standard consumer hardware.
                      </p>
                    </div>
                  </div>

                  <!-- 2. Architecture Comparison -->
                  <div class="space-y-4">
                    <div class="border-b border-slate-800 pb-3">
                      <h4 class="text-2xl font-bold text-white tracking-tight">2. Architecture Comparison</h4>
                      <p class="text-xs text-slate-400 mt-1">Continuous hidden activation shortcuts vs. discrete tokenized Intermediate Representation bottleneck.</p>
                    </div>
                    <div class="glass-card p-4 md:p-6 rounded-2xl border-brand-500/30 overflow-hidden">
                      <svg class="w-full h-auto font-mono select-none" viewBox="0 0 860 360" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <defs>
                          <marker id="arr-slate-ft" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#64748b" /></marker>
                          <marker id="arr-red-ft" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#ef4444" /></marker>
                          <marker id="arr-emerald-ft" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#10b981" /></marker>
                          <marker id="arr-indigo-ft" viewBox="0 0 10 10" refX="6" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M 0 1.5 L 8 5 L 0 8.5 z" fill="#818cf8" /></marker>
                        </defs>
                        <rect x="15" y="15" width="830" height="150" rx="10" fill="#0f172a" stroke="#334155" stroke-dasharray="3 3"/>
                        <text x="35" y="38" fill="#f87171" font-size="11" font-weight="bold">BASELINE: MONOLITHIC ARCHITECTURE (Shared Continuous Activations)</text>
                        <text x="825" y="38" fill="#ef4444" font-size="10" font-weight="bold" text-anchor="end">❌ READOUT UNFAITHFULNESS</text>
                        <rect x="35" y="72" width="80" height="52" rx="6" fill="#1e293b" stroke="#475569"/>
                        <text x="75" y="96" fill="#e2e8f0" font-size="10" text-anchor="middle" font-weight="bold">Input Q</text>
                        <text x="75" y="110" fill="#94a3b8" font-size="8" text-anchor="middle">Math Benchmark</text>
                        <path d="M 115 98 H 155" stroke="#64748b" stroke-width="1.5" marker-end="url(#arr-slate-ft)"/>
